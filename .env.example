# ---------------------------------------------------------------------------
# Frontend (Vite). Everything here is bundled into the browser build, so it must
# contain ONLY public values. Never put a service-role key or a gateway secret
# in a VITE_ variable.
# ---------------------------------------------------------------------------
VITE_SUPABASE_PROJECT_ID=your-project-ref
VITE_SUPABASE_PUBLISHABLE_KEY=your-publishable-or-anon-key
VITE_SUPABASE_URL=https://your-project-ref.supabase.co

# Base URL of the escrow API in server/ (deployed on Railway).
# Leave blank to fall back to Supabase edge functions.
VITE_RAILWAY_FUNCTION_URL=https://your-service.up.railway.app

# Local/development only. Keep false in production.
VITE_ENABLE_PAYMENT_SIMULATOR=false
