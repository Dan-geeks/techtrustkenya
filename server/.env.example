# TechTrust escrow API — server-side environment.
# These are SECRETS. Set them on Railway (`railway variables --set ...`), never
# commit real values, and never expose any of them to the browser.

# --- Supabase ---------------------------------------------------------------
SUPABASE_URL=https://your-project-ref.supabase.co
SUPABASE_PUBLISHABLE_KEY=your-publishable-or-anon-key   # used to verify customer JWTs
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key         # bypasses RLS — server only

# --- Service ----------------------------------------------------------------
# Public base URL of THIS service. Used to build gateway callback URLs.
# On Railway this is derived from RAILWAY_PUBLIC_DOMAIN automatically.
PUBLIC_BASE_URL=https://your-service.up.railway.app
# Comma-separated browser origins allowed to call this API. Blank = allow all.
ALLOWED_ORIGINS=https://johnmwangimegwe.github.io

# Gateways POST to the callback URL unauthenticated, so the secret rides in the
# path: /mpesa-callback/<secret>. Always set this in production.
MPESA_CALLBACK_SECRET=generate-a-long-random-string

# --- Provider selection -----------------------------------------------------
# simulation | safaricom_daraja | kcb_buni
# Leave unset to auto-detect from whichever credentials are present.
PAYMENT_PROVIDER=safaricom_daraja
# simulation | safaricom_b2c | kcb_buni
PAYOUT_PROVIDER=safaricom_b2c

# --- Sandbox testing --------------------------------------------------------
# PAYMENT_TEST_AMOUNT_KSH is IGNORED unless PAYMENT_SANDBOX_MODE is true, so a
# leftover value can never under-charge a real customer.
PAYMENT_SANDBOX_MODE=false
PAYMENT_TEST_AMOUNT_KSH=1
# Settles orders instantly without contacting any gateway. Never enable in prod.
PAYMENT_SIMULATION_ENABLED=false
PAYOUT_SIMULATION_ENABLED=false

# --- Safaricom Daraja (STK Push, C2B) ---------------------------------------
MPESA_BASE_URL=https://sandbox.safaricom.co.ke   # https://api.safaricom.co.ke in production
MPESA_CONSUMER_KEY=
MPESA_CONSUMER_SECRET=
MPESA_SHORTCODE=174379                            # 174379 is the Daraja sandbox paybill
MPESA_PASSKEY=
MPESA_TRANSACTION_TYPE=CustomerPayBillOnline      # CustomerBuyGoodsOnline for a till
# MPESA_TILL_NUMBER=                              # only for buy-goods (PartyB)
# MPESA_CALLBACK_URL=                             # defaults to PUBLIC_BASE_URL/mpesa-callback/<secret>

# --- Safaricom Daraja B2C (vendor payouts) ----------------------------------
MPESA_INITIATOR_NAME=
MPESA_SECURITY_CREDENTIAL=
MPESA_B2C_SHORTCODE=
MPESA_B2C_COMMAND_ID=BusinessPayment
# MPESA_B2C_RESULT_URL=                           # defaults to PUBLIC_BASE_URL/payout-result/<secret>
# MPESA_B2C_TIMEOUT_URL=                          # defaults to PUBLIC_BASE_URL/payout-timeout/<secret>

# --- KCB Buni (alternative gateway) -----------------------------------------
KCB_BUNI_BASE_URL=https://uat.buni.kcbgroup.com
KCB_BUNI_CONSUMER_KEY=
KCB_BUNI_CONSUMER_SECRET=
KCB_BUNI_API_KEY=
KCB_BUNI_ORG_SHORTCODE=522522
KCB_BUNI_ORG_PASSKEY=
KCB_BUNI_DEDICATED_SHORTCODE=false
# KCB_BUNI_PAYOUT_URL=
# KCB_BUNI_SOURCE_ACCOUNT=
# KCB_BUNI_PAYOUT_IS_FINAL=false
